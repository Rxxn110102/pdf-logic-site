# 模型服务：deepseek（默认）、qwen（通义千问）、kimi、openai、anthropic，
# 或填 custom 表示其他 OpenAI 兼容接口（此时必须填写下面的 LLM_BASE_URL 和 LLM_MODEL）。
# 部署在国内服务器时，请用 deepseek / qwen / kimi：OpenAI 和 Anthropic 的接口在国内无法访问。
LLM_PROVIDER=deepseek
# 模型服务的 API 密钥（必填，只保存在服务器上）
LLM_API_KEY=
# 接口地址（可选，留空使用默认值）
#   deepseek: https://api.deepseek.com
#   qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1
#             （如果百炼控制台显示的是带业务空间 ID 的地址，就填控制台里的地址）
#   kimi:     https://api.moonshot.cn/v1
LLM_BASE_URL=
# 模型名称（可选，留空使用默认值：deepseek-flash / qwen-plus / kimi-k2.6）
# 服务商会更新模型，若提示“模型不存在”，到服务商控制台查看最新名称后填在这里。
LLM_MODEL=
# 单次回答的最大 token 数（可选，默认 8000）
LLM_MAX_TOKENS=8000
# 访问码（可选）。设置后访客需要输入访问码才能使用，防止密钥被陌生人消耗
ACCESS_CODE=
# 每个 IP 每分钟最多请求次数（可选，默认 10，填 0 关闭）
RATE_LIMIT_PER_MIN=10
# 服务监听地址和端口（使用 Nginx 时保持 127.0.0.1）
HOST=127.0.0.1
PORT=8787
