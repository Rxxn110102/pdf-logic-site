# 模型接口类型：openai（OpenAI 及兼容接口，如 DeepSeek、通义千问、Kimi）或 anthropic
LLM_PROVIDER=openai
# 模型服务的 API 密钥（必填，只保存在服务器端）
LLM_API_KEY=
# 接口地址（可选）。示例：https://api.deepseek.com/v1 、https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 模型名称（可选）。示例：gpt-4o-mini、deepseek-chat、qwen-plus、claude-sonnet-5-5
LLM_MODEL=
# 单次回答的最大 token 数（可选，默认 8000）
LLM_MAX_TOKENS=8000
# 访问码（可选）。设置后访客需要输入访问码才能使用，防止密钥被陌生人消耗
ACCESS_CODE=
# 每个 IP 每分钟最多请求次数（可选，默认 10，填 0 关闭）
RATE_LIMIT_PER_MIN=10
